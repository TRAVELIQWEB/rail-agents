# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/tests
*.test.mjs
*.test.js

# temporary screenshots & local captures
.hero-grounding-*.png
*-grounding-*.png

# local backups, audit evidence & one-off inspection scripts
/backups/
/data/posts.backup.json
/docs/responsive-audit-*.md
/docs/website-audit-*.md
/scripts/
/get-yt.mjs
check-*.mjs
debug-*.mjs
verify-*.mjs
public/images/hero-bg image.png

# next.js
/.next/
/out/
dist/

# production
/build

# misc & OS
.DS_Store
Thumbs.db
*.pem

# debug & logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# env files (strictly ignore all .env variants and .env.example per repository policy)
.env
.env.*
.env*.local
.env.example
.env.*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Required release tools and regression sources (no generated audit evidence).
!/scripts/
/scripts/*
!/scripts/migrate-whatsapp-settings.mjs
!/tests/
/tests/*
!/tests/*.test.mjs
!/tests/register-server-test-loader.mjs
!/tests/server-test-loader.mjs
/docs/whatsapp-smoke/
