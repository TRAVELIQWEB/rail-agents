# Optional. Set both to enable the latest YouTube videos section.
# Keep the API key server-side; do not prefix it with NEXT_PUBLIC_.
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# Development-only admin UI preview. This is ignored outside NODE_ENV=development.
ADMIN_UI_PREVIEW=false

# Required to use real admin sessions when local preview mode is disabled.
SESSION_SECRET=
ADMIN_SESSION_PASSWORD=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SECRET_PATH=
ADMIN_ENTRY_SECRET=

# Database connection
MONGODB_URI=mongodb://127.0.0.1:27017/railagents

# Railway External Provider (Stations, Train List & Charting)
RAILWAY_STATION_API_URL=https://dev-api-rail.977-24-24-365.co.in/rail/integrations/station-list
RAILWAY_TRAIN_LIST_API_URL=https://dev-api-rail.977-24-24-365.co.in/rail/integrations/train-list
RAILWAY_CHARTING_API_URL=https://dev-api-rail.977-24-24-365.co.in/rail/integrations/charting
RAILWAY_API_KEY=
