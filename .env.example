# Optional. Set both to enable the latest YouTube videos section.
# Keep the API key server-side; do not prefix it with NEXT_PUBLIC_.
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# Development-only admin UI preview. This is ignored outside NODE_ENV=development.
ADMIN_UI_PREVIEW=false

# Required to use real admin sessions when local preview mode is disabled.
SESSION_SECRET=

# Database connection
MONGODB_URI=
